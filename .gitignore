__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.superpowers/
# `ansible-galaxy collection install` run from inside this repo drops ~20 MB of
# third-party collections here. Untracked but easy to `git add -A` by accident,
# and it makes a local `ruff check .` report ~1900 errors from vendored code.
.ansible/
# Per-operator agent state. settings.local.json is where a machine name, a
# cloud project or a tailnet address may live; worktrees are session scratch.
.claude/settings.local.json
.claude/worktrees/
