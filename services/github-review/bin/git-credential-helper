#!/usr/bin/env bash
# git-credential-helper for the github-review service container.
#
# The service mints a token for the one repo a git command is about and hands it
# to that command in its environment (GitWorktreeManager): GIT_REVIEW_REPO names
# the repo, GIT_REVIEW_TOKEN is its installation token. This script only answers
# git's question, and only for that repo.
#
# The Dockerfile sets `credential.useHttpPath true`, so the request carries
# `path=<owner>/<name>.git` for the remote git is actually talking to. A request
# for any other repo gets nothing: a token scoped to one repo must never be
# offered to another remote, whatever a config or a submodule points git at.
set -euo pipefail

[[ "${1:-}" == "get" ]] || exit 0

declare host="" path=""
while IFS= read -r line; do
  [[ -z "$line" ]] && break
  case "$line" in
    host=*) host="${line#host=}" ;;
    path=*) path="${line#path=}" ;;
  esac
done

[[ "$host" == "github.com" ]] || exit 0
[[ -n "${GIT_REVIEW_REPO:-}" && -n "${GIT_REVIEW_TOKEN:-}" ]] || exit 0

# Non-zero, unlike the quiet refusals above: an empty path means the image was
# built without `credential.useHttpPath true`, and then no request can be matched.
if [[ -z "$path" ]]; then
  echo "[git-credential-helper] no path= in the credential request; the image must set credential.useHttpPath true" >&2
  exit 78
fi

[[ "${path%.git}" == "$GIT_REVIEW_REPO" ]] || exit 0

printf 'username=x-access-token\n'
printf 'password=%s\n' "$GIT_REVIEW_TOKEN"
