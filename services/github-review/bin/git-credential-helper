#!/usr/bin/env bash
# git-credential-helper for the github-review service container.
#
# Unlike an agent overlay, this container is NOT scoped to one project: the
# poller fetches every repo in personal/agent-review.yml from the same process,
# so there is no single GITHUB_REPO to stamp into its env. The repo therefore
# comes from git itself — the Dockerfile sets `credential.useHttpPath true`, so
# the credential request carries `path=<owner>/<name>.git` for the remote git is
# actually talking to. That is git naming the repo, not this script re-deriving
# it from a remote URL, which is the guessing that mints wrong-owner tokens.
set -euo pipefail

[[ "${1:-}" == "get" ]] || exit 0

declare host="" path=""
while IFS= read -r line; do
  [[ -z "$line" ]] && break
  case "$line" in
    host=*) host="${line#host=}" ;;
    path=*) path="${line#path=}" ;;
  esac
done

[[ "$host" == "github.com" ]] || exit 0

role="${AGENT_ROLE:-reviewer}"
repo="${path%.git}"

# Non-zero, unlike the router errors below: an empty path means the image was
# built without `credential.useHttpPath true`, and a token minted for a guessed
# owner is worse than no token at all.
if [[ -z "$repo" ]]; then
  echo "[git-credential-helper] no path= in the credential request; the image must set credential.useHttpPath true" >&2
  exit 78
fi

url="${ROUTER_INTERNAL_URL:-http://claude-router:8000}/internal/github-token?role=${role}&repo=${repo}"

resp=$(curl -sS --max-time 5 -w '\n%{http_code}' "$url" 2>&1) || {
  echo "[git-credential-helper] router unreachable at ${url}" >&2
  exit 0
}
http_code="${resp##*$'\n'}"
body="${resp%$'\n'*}"

if [[ "$http_code" != "200" ]]; then
  echo "[git-credential-helper] router returned ${http_code}: ${body}" >&2
  exit 0
fi

token=$(printf '%s' "$body" | jq -r '.token // empty')
if [[ -z "$token" ]]; then
  echo "[git-credential-helper] router returned 200 but no .token field" >&2
  exit 0
fi

printf 'username=x-access-token\n'
printf 'password=%s\n' "$token"
