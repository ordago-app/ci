# Rendered by ansible from personal/github-runners.yml — do not edit on the host.
# GitHub Actions self-hosted runners for {{ github_actions_runners.repository }}.
# Pool = 1 HEAVY + 4 LIGHT; only the heavy runner has /dev/kvm, so at most one
# Android emulator runs at a time. See README.md for the capacity reasoning.
services:
{% for runner in github_actions_runners.runners %}
{% if runner.enabled | default(false) %}
  {{ runner.name }}:
    image: homelab/github-actions-runner:latest
    build:
      context: .
    container_name: github-runner-{{ runner.name }}
    restart: unless-stopped
    # run.sh is PID 1 and does not reap; CI jobs spawn many git/node children
    # whose orphaned grandchildren would otherwise pile up as zombies. tini
    # reaps them and transparently forwards signals to run.sh.
    init: true
    environment:
      RUNNER_REPOSITORY: "{{ github_actions_runners.repository }}"
      RUNNER_NAME: "{{ inventory_hostname }}-{{ runner.name }}"
      RUNNER_LABELS: "{{ (['self-hosted', 'linux', 'x64'] + runner.labels) | join(',') }}"
      RUNNER_WORKDIR: "/runner-work"
      GRADLE_USER_HOME: "/cache/gradle"
      ANDROID_HOME: "/cache/android-sdk"
      ANDROID_SDK_ROOT: "/cache/android-sdk"
      ANDROID_AVD_HOME: "/cache/android-avd"
      PNPM_HOME: "/cache/pnpm"
      MAESTRO_CLI_NO_ANALYTICS: "1"
{% if runner.skip_android_sdk | default(false) %}
      SKIP_ANDROID_SDK: "1"
{% endif %}
    env_file:
      - path: {{ github_actions_runners.secret_env }}
        required: false
    volumes:
{% for vol in runner.volumes %}
      - {{ vol.host }}:{{ vol.container }}:rw
{% endfor %}
{% if runner.kvm | default(false) %}
    devices:
      - "/dev/kvm:/dev/kvm"
{% endif %}
{% if runner.group_add | default([]) %}
    group_add:
{% for gid in runner.group_add %}
      - "{{ gid }}"
{% endfor %}
{% endif %}
    networks:
      - homelab
{% endif %}
{% endfor %}

networks:
  homelab:
    external: true
    name: homelab
